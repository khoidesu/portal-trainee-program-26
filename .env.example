# PORT cấu hình server
PORT=3000

# MONGODB CONNECTION STRING
MONGODB_URI=

# SECURITY: JWT SECRET (Bảo mật phiên đăng nhập)
JWT_SECRET=

# ADMIN CREDENTIALS (Thay đổi mật khẩu quản trị khi triển khai production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Origin chính thức; nhiều địa chỉ phân tách bằng dấu phẩy. Production phải dùng HTTPS.
APP_ORIGIN=http://localhost:3000

# Chỉ bật khi chạy sau một reverse proxy tin cậy; Vercel được nhận diện tự động.
TRUST_PROXY=0


# Cloudflare Turnstile: bắt buộc cho form xin nghỉ trên production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
