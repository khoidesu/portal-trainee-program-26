# PORT cấu hình server
PORT=3000

# MONGODB CONNECTION STRING
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.your-cluster.mongodb.net/trainee_portal?retryWrites=true&w=majority

# SECURITY: JWT SECRET (Bảo mật phiên đăng nhập)
JWT_SECRET=uit_trainee_portal_super_secret_jwt_key_2026_change_in_production

# ADMIN CREDENTIALS (Thay đổi mật khẩu quản trị khi triển khai production)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@UIT2026!

# CORS ORIGIN (Để trống hoặc * để cho phép cùng domain, hoặc điền domain cụ thể: https://portal.uit.edu.vn)
CORS_ORIGIN=*
