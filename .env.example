# PORT cấu hình server
PORT=3000

# MONGODB CONNECTION STRING
MONGODB_URI=

# SECURITY: JWT SECRET (Bảo mật phiên đăng nhập)
JWT_SECRET=

# Quản trị gốc KHÔNG cấu hình ở đây. Tạo trực tiếp trong database: npm run create-admin
# Mật khẩu mặc định cho tài khoản Trainee mới/được reset (bắt buộc ở production, tối thiểu 12 ký tự, ngẫu nhiên)
TRAINEE_DEFAULT_PASSWORD=
TRAINEE_DEFAULT_PASSWORD=traineeprogram

# Origin chính thức; nhiều địa chỉ phân tách bằng dấu phẩy. Production phải dùng HTTPS.
APP_ORIGIN=http://localhost:3000

# Chỉ bật khi chạy sau một reverse proxy tin cậy; Vercel được nhận diện tự động.
TRUST_PROXY=0


# Cloudflare Turnstile: bắt buộc cho form xin nghỉ trên production.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
